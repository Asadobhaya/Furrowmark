# Names only. Never put real values in this file.
# Copy to .env.local for development. Production values live in the host secret store.

NODE_ENV=
PUBLIC_BASE_URL=

# Runtime database user (DML only, no DDL)
DATABASE_URL=
# Migration user (DDL), used only by the migrate script and CI
DATABASE_MIGRATOR_URL=

# 32 random bytes, hex encoded. Separate value per environment.
SESSION_SECRET=
# 32 random bytes, hex encoded. Encrypts MFA secrets and sensitive fields.
FIELD_ENCRYPTION_KEY=

# Store settings (owner supplied)
STORE_NAME=
STORE_LOCALE=
STORE_TIME_ZONE=
STORE_CURRENCY=

# Bot challenge (Cloudflare Turnstile). Leave empty to disable outside production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
